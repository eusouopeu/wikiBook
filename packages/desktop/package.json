{
  "name": "lexicon-desktop",
  "version": "1.0.0",
  "description": "Base de conhecimento pessoal com grafo de conceitos — desktop (Electron)",
  "main": "src/main/main.js",
  "author": "Pedro",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch:renderer\" \"wait-on dist/renderer.js && node scripts/dev-electron.js\"",
    "watch:renderer": "esbuild src/renderer-entry.tsx --bundle --outfile=dist/renderer.js --watch --external:electron",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "esbuild src/renderer-entry.tsx --bundle --outfile=dist/renderer.js --minify --external:electron"
  },
  "dependencies": {
    "@lexicon/shared": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "br.pedro.lexicon",
    "productName": "Wikibook",
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*"
    ]
  }
}
