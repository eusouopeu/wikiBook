{
  "name": "brita",
  "version": "1.0.0",
  "description": "Base de conhecimento pessoal com grafo de conceitos",
  "main": "src/main/main.js",
  "author": "Pedro",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch:renderer\" \"wait-on dist/renderer.js && electron .\"",
    "watch:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer.js --watch --external:electron",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer.js --minify --external:electron"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "br.pedro.brita",
    "productName": "Brita",
    "mac": { "category": "public.app-category.productivity" },
    "files": ["dist/**/*", "src/main/**/*", "src/shared/**/*"]
  }
}
